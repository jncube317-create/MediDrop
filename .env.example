# Copy these names into Railway → your service → Variables.
# Never put real values in this file or in GitHub.

# From Meta → WhatsApp → API Setup (same app as MediDrop is fine, or a new one)
WA_TOKEN=paste-access-token-here
WA_PHONE_NUMBER_ID=paste-phone-number-id-here
# Make up any word. Type the SAME word in Meta's webhook "Verify token" box.
WA_VERIFY_TOKEN=greens-demo-2026
# Meta → App settings → Basic → App secret (click Show)
WA_APP_SECRET=paste-app-secret-here
GRAPH_API_VERSION=v23.0

# The store phone: gets new orders to pack and checks pickup codes.
# Country code, digits only. Every other number is treated as a customer.
STAFF_PHONE=2637XXXXXXXX

STORE_NAME=Greens
BRANCH_NAME=Greens demo branch

# Optional: Paynow TEST MODE. Leave empty and payments are simulated.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
# TESTING ONLY: forces every payment prompt to this one number.
PAYNOW_PAY_PHONE=
# true only after OneMoney is enabled on the Paynow integration
ONEMONEY_ENABLED=false
