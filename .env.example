# Copy these names into Railway → your service → Variables.
# Never put real values in this file or in GitHub.

# From Meta → WhatsApp → Step 1. Try it out (or API Setup)
WA_TOKEN=paste-access-token-here
WA_PHONE_NUMBER_ID=paste-phone-number-id-here
# Make up any random word. Type the SAME word in Meta's webhook "Verify token" box.
WA_VERIFY_TOKEN=medidrop-demo-2026
# Meta → App settings → Basic → App secret (click Show)
WA_APP_SECRET=paste-app-secret-here
# Copy the version from the sample request on Meta's page, e.g. v23.0
GRAPH_API_VERSION=v23.0

# Demo phones, with country code, digits only
PHARMACIST_PHONE=2637XXXXXXXX
DRIVER_PHONE=2637XXXXXXXX
DRIVER_NAME=Tendai

# true = ignore pharmacy opening hours (handy when testing at night)
IGNORE_HOURS=false

# Optional: Paynow TEST MODE. Leave empty and payments are simulated.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
# In test mode use Paynow's test number: 0771111111 = success
PAYNOW_PAY_PHONE=0771111111
