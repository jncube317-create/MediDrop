# Copy these names into Railway → your service → Variables.
# Never put real values in this file or in GitHub.

# From Meta → WhatsApp → API Setup (the same app as MediDrop/Greens is fine)
WA_TOKEN=paste-access-token-here
WA_PHONE_NUMBER_ID=paste-phone-number-id-here
# Make up any word. Type the SAME word in Meta's webhook "Verify token" box.
WA_VERIFY_TOKEN=scoutly-demo-2026
# Meta → App settings → Basic → App secret (click Show)
WA_APP_SECRET=paste-app-secret-here
GRAPH_API_VERSION=v23.0

APP_NAME=Scoutly

# Optional: this phone gets reports and can type STATS. It can also use the bot normally.
# Country code, digits only.
ADMIN_PHONE=2637XXXXXXXX

# Sample listings (with photos), providers and ads so a demo works on one phone.
# Set to false before real people use it.
SAMPLE_PROVIDERS=true
SAMPLE_REPLY_SECONDS=8

# Optional: Paynow TEST MODE for buying credits. Leave empty and payments are simulated.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
# TESTING ONLY: forces every payment prompt to this one number.
PAYNOW_PAY_PHONE=

# Optional: PostHog analytics (EU). No key = no tracking.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Optional: where photos people send are stored (lost on redeploy in the demo).
MEDIA_DIR=/tmp/scoutly-media

# One-time setup for a real number (see README). Remove WA_REGISTER_PIN after the logs say OK.
WA_REGISTER_PIN=
WA_WABA_ID=

# Supabase (database + photos). Without these, data is wiped on every redeploy.
# Project URL is not secret. The service role key IS secret: Railway only, never in chat or code.
SUPABASE_URL=https://etpzlnqnxhrdmegcfthb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
